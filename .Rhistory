library(stringr)
library(tidyr)
library(tibble)
keyify <- function(value, field) {
dplyr::if_else(
field == "email",
stringr::str_to_lower(stringr::str_squish(value)),
stringr::str_to_lower(stringr::str_remove_all(value, "[^A-Za-z]"))
)
}
blank_vals <- c("Incomplete", "1900-01-01", "Not applicable", "")
report_profile1 <- report_profile %>%
mutate(across(where(is.character), ~ {
x <- str_squish(.x)
if_else(x %in% blank_vals, NA_character_, x)
})) %>%
mutate(
EMAIL = coalesce(update_email_2_v2,      latest_email_v2),
FNAME = coalesce(update_first_name_2_v2, latest_fname_v2),
LNAME = coalesce(update_last_name_2_v2,  latest_lname_v2)
) %>%
select(
1, 4,
EMAIL, update_email_2_v2,      latest_email_v2,
FNAME, update_first_name_2_v2, latest_fname_v2,
LNAME, update_last_name_2_v2,  latest_lname_v2
) %>%
mutate(row_id = row_number())
targets <- tribble(
~fname,    ~lname,      ~email,
"Marissa", "Dugan",     "marissadugan@outlook.com",
"Tayler",  "Bodimeade", "taylerbodimeade@gmail.com",
"Sarah",   "Carlin",    "sarahc0889@gmail.com"
)
targets_keys <- targets %>%
mutate(
person    = paste(fname, lname),
email_key = keyify(email, "email"),
fname_key = keyify(fname, "fname"),
lname_key = keyify(lname, "lname")
) %>%
select(person, email, fname, lname, email_key, fname_key, lname_key)
make_keys <- function(df, e_col, f_col, l_col, source_label) {
df %>%
transmute(
row_id,
source    = source_label,
email_val = .data[[e_col]],
fname_val = .data[[f_col]],
lname_val = .data[[l_col]],
email_key = keyify(email_val, "email"),
fname_key = keyify(fname_val, "fname"),
lname_key = keyify(lname_val, "lname")
)
}
library(dplyr)
library(stringr)
library(tidyr)
library(tibble)
# -----------------------------------------------------------------------------
# 0. Helper -- normalize values into comparison keys
#    email -> lowercase, whitespace squished
#    names -> lowercase, letters only (drops hyphens, apostrophes, spaces)
# -----------------------------------------------------------------------------
keyify <- function(value, field) {
# `field` may be a single string or a full column -- recycle so if_else()
# always sees a condition the same length as `value`
field <- rep_len(field, length(value))
dplyr::if_else(
field == "email",
stringr::str_to_lower(stringr::str_squish(value)),
stringr::str_to_lower(stringr::str_remove_all(value, "[^A-Za-z]"))
)
}
# -----------------------------------------------------------------------------
# 1. Clean the raw export and build the combined working fields
# -----------------------------------------------------------------------------
blank_vals <- c("Incomplete", "1900-01-01", "Not applicable", "")
report_profile1 <- report_profile %>%
mutate(across(where(is.character), ~ {
x <- str_squish(.x)
if_else(x %in% blank_vals, NA_character_, x)
})) %>%
mutate(
EMAIL = coalesce(update_email_2_v2,      latest_email_v2),
FNAME = coalesce(update_first_name_2_v2, latest_fname_v2),
LNAME = coalesce(update_last_name_2_v2,  latest_lname_v2)
) %>%
select(
1, 4,
EMAIL, update_email_2_v2,      latest_email_v2,
FNAME, update_first_name_2_v2, latest_fname_v2,
LNAME, update_last_name_2_v2,  latest_lname_v2
) %>%
mutate(row_id = row_number())
# -----------------------------------------------------------------------------
# 2. Targets
# -----------------------------------------------------------------------------
targets <- tribble(
~fname,    ~lname,      ~email,
"Marissa", "Dugan",     "marissadugan@outlook.com",
"Tayler",  "Bodimeade", "taylerbodimeade@gmail.com",
"Sarah",   "Carlin",    "sarahc0889@gmail.com"
)
targets_keys <- targets %>%
mutate(
person    = paste(fname, lname),
email_key = keyify(email, "email"),
fname_key = keyify(fname, "fname"),
lname_key = keyify(lname, "lname")
) %>%
select(person, email, fname, lname, email_key, fname_key, lname_key)
# -----------------------------------------------------------------------------
# 3. Build one key set per source, then stack them
#    combined = coalesce(updated, latest); latest and updated are the raw columns
# -----------------------------------------------------------------------------
make_keys <- function(df, e_col, f_col, l_col, source_label) {
df %>%
transmute(
row_id,
source    = source_label,
email_val = .data[[e_col]],
fname_val = .data[[f_col]],
lname_val = .data[[l_col]],
email_key = keyify(email_val, "email"),
fname_key = keyify(fname_val, "fname"),
lname_key = keyify(lname_val, "lname")
)
}
prof_keys <- bind_rows(
make_keys(report_profile1, "EMAIL", "FNAME", "LNAME", "combined"),
make_keys(report_profile1, "latest_email_v2", "latest_fname_v2",
"latest_lname_v2", "latest"),
make_keys(report_profile1, "update_email_2_v2", "update_first_name_2_v2",
"update_last_name_2_v2", "updated")
) %>%
filter(!is.na(email_key) | !is.na(fname_key) | !is.na(lname_key))
# -----------------------------------------------------------------------------
# 4. ALL-THREE MATCH -- every field must hit on the same row_id
# -----------------------------------------------------------------------------
all3_hits <- targets_keys %>%
inner_join(prof_keys, by = c("email_key", "fname_key", "lname_key")) %>%
select(person, row_id, source,
target_email = email, target_fname = fname, target_lname = lname)
all3_records <- all3_hits %>%
group_by(person, row_id) %>%
summarise(matched_sources = paste(sort(unique(source)), collapse = "+"),
.groups = "drop") %>%
left_join(report_profile1, by = "row_id") %>%
arrange(person)
cat("\n=== ALL THREE FIELDS MATCHED ON ONE RECORD ===\n")
print(all3_records, n = Inf, width = Inf)
all3_verdict <- targets_keys %>%
select(person, email, fname, lname) %>%
left_join(count(all3_hits, person, name = "n_hits"), by = "person") %>%
mutate(
n_hits    = coalesce(n_hits, 0L),
all3_match = if_else(n_hits > 0, "YES", "NO")
) %>%
select(person, fname, lname, email, all3_match)
cat("\n=== VERDICT ===\n")
print(all3_verdict, n = Inf)
failed <- all3_verdict %>% filter(all3_match == "NO") %>% pull(person)
partial_matches <- targets_keys %>%
filter(person %in% failed) %>%
crossing(prof_keys) %>%
mutate(
hit_email = !is.na(email_key1) & email_key == email_key1,
hit_fname = !is.na(fname_key1) & fname_key == fname_key1,
hit_lname = !is.na(lname_key1) & lname_key == lname_key1,
n_fields  = hit_email + hit_fname + hit_lname,
fields    = paste0(
if_else(hit_email, "email", ""), if_else(hit_fname, "+fname", ""),
if_else(hit_lname, "+lname", "")
) %>% str_remove("^\\+") %>% str_replace_all("\\+\\+", "+")
) %>%
filter(n_fields >= 2) %>%
select(person, row_id, source, n_fields, fields,
rec_email = email_val, rec_fname = fname_val, rec_lname = lname_val) %>%
distinct() %>%
arrange(person, desc(n_fields), row_id)
# =============================================================================
# REDCap -- all-three match (FNAME + LNAME + EMAIL on the SAME record)
#
# Standalone. Needs only `report_profile` in the environment.
# FINAL PRODUCT: `matched_records` -- one row per matched participant record,
# flagged ALL3 / PARTIAL, with the full profile columns attached.
# =============================================================================
library(dplyr)
library(stringr)
library(tidyr)
library(tibble)
library(readr)
MIN_FIELDS <- 2   # keep records matching at least this many of the 3 fields
# -----------------------------------------------------------------------------
# 0. Helper -- normalize values into comparison keys
# -----------------------------------------------------------------------------
keyify <- function(value, field) {
field <- rep_len(field, length(value))
dplyr::if_else(
field == "email",
stringr::str_to_lower(stringr::str_squish(value)),
stringr::str_to_lower(stringr::str_remove_all(value, "[^A-Za-z]"))
)
}
# -----------------------------------------------------------------------------
# 1. Clean the export, build combined working fields
# -----------------------------------------------------------------------------
blank_vals <- c("Incomplete", "1900-01-01", "Not applicable", "")
report_profile1 <- report_profile %>%
mutate(across(where(is.character), ~ {
x <- str_squish(.x)
if_else(x %in% blank_vals, NA_character_, x)
})) %>%
mutate(
EMAIL = coalesce(update_email_2_v2,      latest_email_v2),
FNAME = coalesce(update_first_name_2_v2, latest_fname_v2),
LNAME = coalesce(update_last_name_2_v2,  latest_lname_v2)
) %>%
select(
1, 4,
EMAIL, update_email_2_v2,      latest_email_v2,
FNAME, update_first_name_2_v2, latest_fname_v2,
LNAME, update_last_name_2_v2,  latest_lname_v2
) %>%
mutate(row_id = row_number())
# -----------------------------------------------------------------------------
# 2. Targets
# -----------------------------------------------------------------------------
targets <- tribble(
~fname,    ~lname,      ~email,
"Marissa", "Dugan",     "marissadugan@outlook.com",
"Tayler",  "Bodimeade", "taylerbodimeade@gmail.com",
"Sarah",   "Carlin",    "sarahc0889@gmail.com"
)
targets_keys <- targets %>%
transmute(
person       = paste(fname, lname),
target_fname = fname,
target_lname = lname,
target_email = email,
email_key    = keyify(email, "email"),
fname_key    = keyify(fname, "fname"),
lname_key    = keyify(lname, "lname")
)
# -----------------------------------------------------------------------------
# 3. One key set per source, stacked
# -----------------------------------------------------------------------------
make_keys <- function(df, e_col, f_col, l_col, source_label) {
df %>%
transmute(
row_id,
source    = source_label,
rec_email = .data[[e_col]],
rec_fname = .data[[f_col]],
rec_lname = .data[[l_col]],
email_key = keyify(rec_email, "email"),
fname_key = keyify(rec_fname, "fname"),
lname_key = keyify(rec_lname, "lname")
)
}
prof_keys <- bind_rows(
make_keys(report_profile1, "EMAIL", "FNAME", "LNAME", "combined"),
make_keys(report_profile1, "latest_email_v2", "latest_fname_v2",
"latest_lname_v2", "latest"),
make_keys(report_profile1, "update_email_2_v2", "update_first_name_2_v2",
"update_last_name_2_v2", "updated")
) %>%
filter(!is.na(email_key) | !is.na(fname_key) | !is.na(lname_key))
# -----------------------------------------------------------------------------
# 4. Field-level hits -- three separate joins, stacked
#    (no crossing(), so no duplicate key-column names)
# -----------------------------------------------------------------------------
t_base <- targets_keys %>% select(person, target_fname, target_lname, target_email)
hit_email <- targets_keys %>%
select(person, email_key) %>%
inner_join(prof_keys, by = "email_key") %>%
mutate(field = "email")
hit_fname <- targets_keys %>%
select(person, fname_key) %>%
inner_join(prof_keys, by = "fname_key") %>%
mutate(field = "fname")
hit_lname <- targets_keys %>%
select(person, lname_key) %>%
inner_join(prof_keys, by = "lname_key") %>%
mutate(field = "lname")
hits_long <- bind_rows(hit_email, hit_fname, hit_lname) %>%
select(person, row_id, source, field, rec_email, rec_fname, rec_lname)
# -----------------------------------------------------------------------------
# 5. Collapse to person x record x source -- how many of the 3 fields matched
# -----------------------------------------------------------------------------
match_summary <- hits_long %>%
group_by(person, row_id, source) %>%
summarise(
n_fields       = n_distinct(field),
fields_matched = paste(sort(unique(field)), collapse = "+"),
rec_email      = first(rec_email),
rec_fname      = first(rec_fname),
rec_lname      = first(rec_lname),
.groups = "drop"
) %>%
mutate(match_type = if_else(n_fields == 3, "ALL3", "PARTIAL"))
# -----------------------------------------------------------------------------
# 6. FINAL DATASET -- matched records with full profile columns
# -----------------------------------------------------------------------------
matched_records <- match_summary %>%
filter(n_fields >= MIN_FIELDS) %>%
left_join(t_base, by = "person") %>%
left_join(report_profile1, by = "row_id") %>%
arrange(person, desc(n_fields), row_id, source) %>%
select(
person, match_type, n_fields, fields_matched, source, row_id,
target_fname, target_lname, target_email,
rec_fname, rec_lname, rec_email,
everything()
)
cat("\n=== MATCHED RECORDS ===\n")
print(matched_records, n = Inf, width = Inf)
# All-three only
matched_all3 <- matched_records %>% filter(match_type == "ALL3")
# -----------------------------------------------------------------------------
# 7. Verdict -- one row per target
# -----------------------------------------------------------------------------
verdict <- targets_keys %>%
select(person, target_fname, target_lname, target_email) %>%
left_join(
matched_records %>%
group_by(person) %>%
summarise(
all3        = if_else(any(match_type == "ALL3"), "YES", "NO"),
best_fields = max(n_fields),
n_records   = n_distinct(row_id),
.groups = "drop"
),
by = "person"
) %>%
mutate(
all3        = coalesce(all3, "NO"),
best_fields = coalesce(best_fields, 0L),
n_records   = coalesce(n_records, 0L)
)
cat("\n=== VERDICT ===\n")
print(verdict, n = Inf)
# -----------------------------------------------------------------------------
# 8. Export
# -----------------------------------------------------------------------------
write_csv(matched_records, "C:/Users/luxxx371/Box/Requests/Momcology/2026 Events/matched_records.csv")
cat("\nWrote matched_records.csv (", nrow(matched_records), " rows )\n", sep = "")
# =============================================================================
# REDCap -- flexible match for TAYLER BODIMEADE only
#
# Handles the alternate surname "Brake" (maiden/married name). A fuzzy string
# matcher will NEVER connect "Brake" to "Bodimeade" -- they share almost no
# characters -- so Brake is checked as its own explicit pass, independent of
# the fuzzy thresholds. Nothing gets missed just because flex didn't catch it.
#
# Standalone. Needs only `report_profile`.
# FINAL PRODUCT: `tayler_candidates`
# =============================================================================
library(dplyr)
library(stringr)
library(tidyr)
library(tibble)
library(readr)
# ---- target -----------------------------------------------------------------
T_FNAME  <- "Tayler"
T_LNAME  <- "Bodimeade"
T_LALT   <- "Brake"                       # alternate / prior surname
T_EMAIL  <- "taylerbodimeade@gmail.com"
SIM_NAME  <- 0.75   # name similarity threshold
SIM_EMAIL <- 0.70   # email local-part similarity threshold
# ---- helpers ----------------------------------------------------------------
keyify <- function(value, field) {
field <- rep_len(field, length(value))
if_else(field == "email",
str_to_lower(str_squish(value)),
str_to_lower(str_remove_all(value, "[^A-Za-z]")))
}
# base-R similarity, 0-1; no stringdist dependency
str_sim <- function(a, b) {
mapply(function(x, y) {
if (is.na(x) || is.na(y) || nchar(x) == 0 || nchar(y) == 0) return(NA_real_)
1 - adist(x, y)[1, 1] / max(nchar(x), nchar(y))
}, a, b, USE.NAMES = FALSE)
}
local_part <- function(x) str_remove(x, "@.*")
# ---- 1. clean ---------------------------------------------------------------
blank_vals <- c("Incomplete", "1900-01-01", "Not applicable", "")
report_profile1 <- report_profile %>%
mutate(across(where(is.character), ~ {
x <- str_squish(.x); if_else(x %in% blank_vals, NA_character_, x)
})) %>%
mutate(
EMAIL = coalesce(update_email_2_v2,      latest_email_v2),
FNAME = coalesce(update_first_name_2_v2, latest_fname_v2),
LNAME = coalesce(update_last_name_2_v2,  latest_lname_v2)
) %>%
select(1, 4,
EMAIL, update_email_2_v2,      latest_email_v2,
FNAME, update_first_name_2_v2, latest_fname_v2,
LNAME, update_last_name_2_v2,  latest_lname_v2) %>%
mutate(row_id = row_number())
# ---- 2. long by source ------------------------------------------------------
make_keys <- function(df, e, f, l, src) {
df %>% transmute(
row_id, source = src,
rec_email = .data[[e]], rec_fname = .data[[f]], rec_lname = .data[[l]],
email_key = keyify(rec_email, "email"),
fname_key = keyify(rec_fname, "fname"),
lname_key = keyify(rec_lname, "lname")
)
}
prof_keys <- bind_rows(
make_keys(report_profile1, "EMAIL", "FNAME", "LNAME", "combined"),
make_keys(report_profile1, "latest_email_v2", "latest_fname_v2",
"latest_lname_v2", "latest"),
make_keys(report_profile1, "update_email_2_v2", "update_first_name_2_v2",
"update_last_name_2_v2", "updated")
) %>%
filter(!is.na(email_key) | !is.na(fname_key) | !is.na(lname_key))
# ---- 3. score every record against Tayler -----------------------------------
k_fname <- keyify(T_FNAME, "fname")
k_lname <- keyify(T_LNAME, "lname")
k_lalt  <- keyify(T_LALT,  "lname")
k_email <- keyify(T_EMAIL, "email")
k_local <- local_part(k_email)
scored <- prof_keys %>%
mutate(
email_local = local_part(email_key),
sim_fname   = str_sim(fname_key,   k_fname),
sim_lname   = str_sim(lname_key,   k_lname),
sim_lalt    = str_sim(lname_key,   k_lalt),
sim_email   = str_sim(email_local, k_local),
exact_email = !is.na(email_key) & email_key == k_email,
exact_fname = !is.na(fname_key) & fname_key == k_fname,
exact_lname = !is.na(lname_key) & lname_key == k_lname,
exact_lalt  = !is.na(lname_key) & lname_key == k_lalt,
# substring catches truncation / hyphenated-name fragments
sub_lname = !is.na(lname_key) &
(str_detect(lname_key, fixed(substr(k_lname, 1, 4))) |
str_detect(k_lname, fixed(substr(lname_key, 1, 4)))),
sub_lalt  = !is.na(lname_key) &
(str_detect(lname_key, fixed(k_lalt)) | str_detect(k_lalt, fixed(lname_key))),
sub_email = !is.na(email_local) &
(str_detect(email_local, fixed(substr(k_local, 1, 6))) |
str_detect(k_local, fixed(substr(email_local, 1, 6))))
)
# ---- 4. flag WHY each record is a candidate ---------------------------------
flagged <- scored %>%
mutate(
r_email_exact = exact_email,
r_email_flex  = !exact_email & (coalesce(sim_email, 0) >= SIM_EMAIL | sub_email),
r_fname       = exact_fname | coalesce(sim_fname, 0) >= SIM_NAME,
r_lname       = exact_lname | coalesce(sim_lname, 0) >= SIM_NAME | sub_lname,
# --- the Brake pass: explicit, threshold-independent ---
r_brake       = exact_lalt | sub_lalt | coalesce(sim_lalt, 0) >= SIM_NAME
) %>%
mutate(
reason = paste(
if_else(r_email_exact, "email_exact;", ""),
if_else(r_email_flex,  "email_flex;",  ""),
if_else(r_fname,       "fname;",       ""),
if_else(r_lname,       "lname_bodimeade;", ""),
if_else(r_brake,       "LNAME_BRAKE;", ""),
sep = ""
) %>% str_remove(";$"),
n_signals = r_email_exact + r_email_flex + r_fname + r_lname + r_brake
)
# ---- 5. FINAL: candidates ---------------------------------------------------
tayler_candidates <- flagged %>%
filter(n_signals >= 1) %>%
left_join(report_profile1 %>% select(-EMAIL, -FNAME, -LNAME), by = "row_id") %>%
mutate(
hit_brake = r_brake,
strength  = case_when(
r_email_exact & r_fname & r_brake ~ "STRONG - email+fname+Brake",
r_email_exact & r_brake           ~ "STRONG - email+Brake",
r_email_exact & r_fname           ~ "STRONG - email+fname",
r_brake & r_fname                 ~ "MEDIUM - Brake+fname",
r_email_exact | r_email_flex      ~ "MEDIUM - email only",
r_brake                           ~ "REVIEW - Brake surname only",
TRUE                              ~ "WEAK - name fragment only"
)
) %>%
arrange(desc(n_signals), desc(sim_email)) %>%
select(row_id, source, strength, reason, n_signals, hit_brake,
rec_fname, rec_lname, rec_email,
sim_fname, sim_lname, sim_lalt, sim_email,
everything())
cat("\n=== TAYLER -- FLEX CANDIDATES ===\n")
print(tayler_candidates, n = Inf, width = Inf)
# ---- 6. Safety net: EVERY record whose surname is Brake ---------------------
# Runs regardless of email or first name, so a Brake record can never be
# dropped by the fuzzy thresholds above.
brake_records <- prof_keys %>%
filter(!is.na(lname_key), lname_key == k_lalt) %>%
left_join(report_profile1, by = "row_id") %>%
mutate(in_flex = row_id %in% tayler_candidates$row_id) %>%
arrange(row_id, source)
cat("\n=== ALL RECORDS WITH SURNAME 'BRAKE' ===\n")
if (nrow(brake_records) == 0) {
cat("None found.\n")
} else {
print(brake_records, n = Inf, width = Inf)
cat("\nBrake records NOT captured by the flex pass: ",
sum(!brake_records$in_flex), "\n", sep = "")
}
# ---- 7. export --------------------------------------------------------------
write_csv(tayler_candidates, "C:/Users/luxxx371/Box/Requests/Momcology/2026 Events/tayler_flex_candidates.csv")
write_csv(brake_records,     "C:/Users/luxxx371/Box/Requests/Momcology/2026 Events/tayler_brake_records.csv")
cat("\nWrote tayler_flex_candidates.csv (", nrow(tayler_candidates), " rows) and ",
"tayler_brake_records.csv (", nrow(brake_records), " rows)\n", sep = "")
